CREATE MEMORY TABLE PUBLIC.BOOK(ID INTEGER GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,FILE_PATH VARCHAR(255),LAST_ACCESSED BIGINT,TITLE VARCHAR(255))
ALTER TABLE PUBLIC.BOOK ALTER COLUMN ID RESTART WITH 115
CREATE MEMORY TABLE PUBLIC.NOUN(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BOOK_ID INTEGER,DUAL VARCHAR(255),EXAMPLE VARCHAR(255),MEANING VARCHAR(255),PAGE_ID INTEGER,PLURAL VARCHAR(255),SINGULAR VARCHAR(255),WORD VARCHAR(255))
ALTER TABLE PUBLIC.NOUN ALTER COLUMN ID RESTART WITH 1155
CREATE MEMORY TABLE PUBLIC.PAGE(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BOOK_ID INTEGER,CONTENT VARCHAR(255),PAGE_NUMBER INTEGER,TRANSLATION VARCHAR(255),PAGE_ID INTEGER)
ALTER TABLE PUBLIC.PAGE ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.VERB(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 1) NOT NULL PRIMARY KEY,BAB VARCHAR(255),BOOK_ID INTEGER,COMMAND VARCHAR(255),EXAMPLE VARCHAR(255),FUTURE VARCHAR(255),MASDAR VARCHAR(255),MEANING VARCHAR(255),PAGE_ID INTEGER,PAST VARCHAR(255),WORD VARCHAR(255))
ALTER TABLE PUBLIC.VERB ALTER COLUMN ID RESTART WITH 1134
CREATE MEMORY TABLE PUBLIC.USER_SESSION(BOOK_ID INTEGER NOT NULL PRIMARY KEY,ACCESSED_AT BIGINT,PAGE_ID INTEGER,ZOOM_FACTOR DOUBLE,OPEN_AT_STARTUP BOOLEAN,PAGE_COUNT INTEGER)
CREATE MEMORY TABLE PUBLIC.MEDIA_LINK(ID VARCHAR(255) NOT NULL PRIMARY KEY,BOOK_ID INTEGER,PAGE_ID INTEGER)
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
